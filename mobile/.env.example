# Layer 12A — public mobile configuration. Copy to .env.local (git-ignored).
# Only PUBLIC values belong here. Never add a Supabase service-role/secret key,
# a database password, FatSecret/WHOOP/provider secrets or any other secret:
# everything prefixed EXPO_PUBLIC_ is compiled into the app bundle, and
# app.config.ts refuses to start if a secret-looking variable is present.

# development | staging | production (required; there is no default)
EXPO_PUBLIC_APP_ENV=development

# MyRecipeBook API origin WITHOUT /v1. https is required outside development.
# A phone cannot reach "localhost": use your computer's LAN IP (development only)
# or a hosted HTTPS URL. See README.md "Running on a real phone".
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:3000

# Supabase project URL and the anon (or sb_publishable_) key for the SAME
# environment as the API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-anon-or-publishable-key

# Optional: comma-separated OAuth providers configured in this Supabase project
# (google, apple). Leave empty until they are configured (external config).
EXPO_PUBLIC_AUTH_OAUTH_PROVIDERS=
