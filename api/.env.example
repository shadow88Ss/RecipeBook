# MyRecipeBook API — server-side configuration. Copy to .env (git-ignored)
# locally, or set these in the hosting provider's secret/env settings.
# Never put any of these in the mobile app.

NODE_ENV=development
PORT=3000

# Supabase project (Project Settings -> API). The anon/publishable key is
# forwarded with each caller's own token; the API never uses a service-role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key

# Access-token verification (docs/37_Authentication_and_Login.md §16).
# jwks                   -> current Supabase JWT signing keys (ES256/RS256). Use this.
# legacy_hs256           -> legacy shared secret only (local Supabase stack / old projects)
# jwks_with_legacy_hs256 -> only while migrating a project to signing keys
SUPABASE_JWT_VERIFICATION=jwks

# Optional overrides; defaults are ${SUPABASE_URL}/auth/v1 and its
# /.well-known/jwks.json.
# SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Legacy HS256 secret: ONLY for the legacy modes (Project Settings -> JWT Keys
# -> Legacy JWT Secret). Leave unset for jwks.
# SUPABASE_JWT_SECRET=

LOG_LEVEL=info
